# Embedding provider: openai (hosted, needs a key) or ollama (local, free)
EMBEDDING_PROVIDER=openai

# --- openai ---
OPENAI_API_KEY=sk-...
# EMBEDDING_MODEL=text-embedding-3-small

# --- ollama (no key needed; run `ollama pull nomic-embed-text`) ---
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_URL=http://localhost:11434

# Similarity cutoff. Defaults per provider (openai 0.82, ollama 0.62)
# because thresholds are not portable between models. Calibrate with
# scripts/dryrun.py --show-near-misses.
# SIMILARITY_THRESHOLD=0.62

GITHUB_TOKEN=ghp_...
GITHUB_WEBHOOK_SECRET=your-webhook-secret
DB_PATH=jaccard.db
