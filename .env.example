# GitHub Personal Access Token.
# Without one the GitHub API is rate-limited to 60 requests/hour.
# Create at https://github.com/settings/tokens
# Scopes: public_repo for public repos, repo for private.
GITHUB_TOKEN=ghp_your_token_here

# Shared secret for webhook signature verification (webhook service only).
GITHUB_WEBHOOK_SECRET=your-webhook-secret

DB_PATH=jaccard.db

# --- Embedding pipeline ---
# Provider: openai (hosted, needs a key) or ollama (local, free).
# Not needed for the token-similarity search API, which uses no embeddings.
EMBEDDING_PROVIDER=openai

# openai
OPENAI_API_KEY=sk-...
# EMBEDDING_MODEL=text-embedding-3-small

# ollama (no key; run `ollama pull nomic-embed-text` first)
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_URL=http://localhost:11434

# Similarity cutoff. Defaults per provider (openai 0.82, ollama 0.62)
# because thresholds are not portable between models.
# SIMILARITY_THRESHOLD=0.62
