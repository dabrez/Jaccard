# ---------------------------------------------------------------------------
# GitHub token  (required)
# ---------------------------------------------------------------------------
# Without one, the GitHub API allows only 60 requests/hour.
# Create at: https://github.com/settings/tokens
#   public repos  -> public_repo
#   private repos -> repo
# Or reuse the gh CLI's token:  GITHUB_TOKEN=$(gh auth token)
GITHUB_TOKEN=

# Shared secret for webhook signature verification (webhook service only).
# Must match the secret configured on the GitHub webhook. REQUIRED to run
# the webhook service: with this unset, unsigned requests are rejected.
GITHUB_WEBHOOK_SECRET=

# Local development only: accept unsigned webhooks when no secret is set.
# Never enable this on anything reachable from the internet — the service
# comments on and closes issues.
# ALLOW_UNSIGNED_WEBHOOKS=1

# ---------------------------------------------------------------------------
# Storage — the two implementations need SEPARATE files.
# Both define an `issues` table with different columns, so sharing one
# database corrupts whichever runs second.
# ---------------------------------------------------------------------------
# Embedding pipeline (app/, scripts/)
DB_PATH=jaccard.db
# Token-similarity search API (main.py)
SEARCH_DB_PATH=jaccard_search.db

# ---------------------------------------------------------------------------
# Embeddings — local Ollama, no API key
# ---------------------------------------------------------------------------
# Requires: ollama pull nomic-embed-text
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_URL=http://localhost:11434

# Vector width for a model not in app/embeddings.py's table.
# EMBEDDING_DIMENSIONS=768

# Similarity cutoff (default 0.62, measured for nomic-embed-text).
# Not portable between models — recalibrate with scripts/dryrun.py.
# SIMILARITY_THRESHOLD=0.62
